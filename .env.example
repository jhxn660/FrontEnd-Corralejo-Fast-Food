# URL del backend (Backend-Corralejo-Fast-Food), SIN /api.
VITE_API_URL=http://localhost:3000

# Dirección pública de la aplicación, la que se codifica en el QR del tiquete.
# En producción tiene que ser el dominio real: el QR se escanea desde un
# teléfono, que no sabe nada de localhost. Si se omite, se usa el origen actual.
VITE_APP_URL=http://localhost:5173

# Tiempo máximo de espera de la API, en milisegundos (opcional).
VITE_API_TIMEOUT_MS=15000

# Cada cuánto se refresca la pantalla visible para ver cambios hechos desde
# OTRO dispositivo, en milisegundos (opcional; 0 lo desactiva). Entre pestañas
# del mismo navegador los cambios llegan al instante.
VITE_SYNC_MS=10000

# WhatsApp del local (con indicativo, sin +). Se usa si la ficha del local no tiene teléfono.
VITE_WHATSAPP_NUMERO=573118370904
