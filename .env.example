# Credenciales de Supabase (Project Settings -> API).
# Copia este archivo como .env y reemplaza los valores.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-publishable-key

# API REST local (json-server). Debe coincidir con el script "npm run api".
VITE_API_URL=http://localhost:3000

# Tiempo máximo de espera de la API, en milisegundos (opcional).
VITE_API_TIMEOUT_MS=15000
